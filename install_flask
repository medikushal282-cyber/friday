import sys
from flask import Flask, render_template_string

app = Flask(__name__)

# Dummy ecommerce data for the dashboard
dashboard_data = {
    "total_sales": "$125,430",
    "orders_today": 87,
    "new_customers": 23,
    "top_products": [
        {"name": "Wireless Headphones", "sales": "$12,340"},
        {"name": "Smartwatch Pro", "sales": "$9,210"},
        {"name": "Gaming Laptop", "sales": "$15,780"},
    ],
    "revenue_by_category": {
        "Electronics": "$68,400",
        "Apparel": "$32,100",
        "Home & Kitchen": "$24,930",
    },
}

HTML_TEMPLATE = """
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>E‑Commerce Dashboard</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <!-- Bootstrap 5 CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background-color: #f8f9fa; }
        .card { margin-bottom: 1rem; }
        .table thead { background-color: #e9ecef; }
    </style>
</head>
<body>
<div class="container py-4">
    <h1 class="mb-4">📊 E‑Commerce Dashboard</h1>

    <div class="row">
        <div class="col-md-3">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Total Sales</h5>
                    <p class="display-6 fw-bold">{{ total_sales }}</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Orders Today</h5>
                    <p class="display-6 fw-bold">{{ orders_today }}</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">New Customers</h5>
                    <p class="display-6 fw-bold">{{ new_customers }}</p>
                </div>
            </div>
        </div>
    </div>

    <h3 class="mt-5">Top Selling Products</h3>
    <table class="table table-striped table-hover shadow-sm">
        <thead class="table-light">
            <tr>
                <th scope="col">#</th>
                <th scope="col">Product</th>
                <th scope="col">Sales</th>
            </tr>
        </thead>
        <tbody>
            {% for product in top_products %}
            <tr>
                <th scope="row">{{ loop.index }}</th>
                <td>{{ product.name }}</td>
                <td>{{ product.sales }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>

    <h3 class="mt-5">Revenue by Category</h3>
    <div class="row">
        {% for category, amount in revenue_by_category.items() %}
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">{{ category }}</h5>
                    <p class="display-6 fw-bold">{{ amount }}</p>
                </div>
            </div>
        </div>
        {% endfor %}
    </div>
</div>

<!-- Bootstrap JS (optional) -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
"""

@app.route("/")
def dashboard():
    return render_template_string(
        HTML_TEMPLATE,
        total_sales=dashboard_data["total_sales"],
        orders_today=dashboard_data["orders_today"],
        new_customers=dashboard_data["new_customers"],
        top_products=dashboard_data["top_products"],
        revenue_by_category=dashboard_data["revenue_by_category"],
    )

def main():
    """
    Entry point for the Flask application.
    The function checks that Flask is installed; if not, it prints an informative
    message and exits with a non‑zero status.
    """
    try:
        # Ensure the Flask version is recent enough (optional check)
        import flask
        if tuple(map(int, flask.__version__.split("."))) < (2, 0):
            print("Flask 2.0 or newer is required.", file=sys.stderr)
            sys.exit(1)
    except ImportError:
        print(
            "Flask is not installed. Install it with: pip install Flask",
            file=sys.stderr,
        )
        sys.exit(1)

    # Run the development server
    app.run(host="0.0.0.0", port=5000, debug=True)

if __name__ == "__main__":
    main()
