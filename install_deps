#!/usr/bin/env python3
import sys
import subprocess
import os


def _run_pip(args):
    """Run pip with the given argument list.
    Returns True on success, False on failure."""
    try:
        subprocess.check_call([sys.executable, "-m", "pip"] + args)
        return True
    except subprocess.CalledProcessError as e:
        print(f"Warning: pip returned non‑zero exit code {e.returncode}. Continuing without aborting.")
        return False
    except Exception as e:
        print(f"Warning: Unexpected error while invoking pip: {e}. Continuing without aborting.")
        return False


def install_requirements():
    """
    Install project dependencies.

    If a `requirements.txt` file exists, it will be used.
    Otherwise, a minimal set of common web‑development packages is installed.

    The function is tolerant to failures (e.g., no internet access) – it will
    emit warnings instead of aborting the whole script, which makes it safe
    to run in constrained test environments.
    """
    req_file = "requirements.txt"

    if os.path.isfile(req_file):
        print(f"Installing dependencies from {req_file}...")
        _run_pip(["install", "-r", req_file])
    else:
        # Fallback to a basic set of packages useful for a simple web project.
        default_deps = ["flask", "gunicorn"]
        print("No requirements.txt found. Installing default dependencies:", ", ".join(default_deps))
        _run_pip(["install"] + default_deps)

    print("Dependency installation step finished (errors, if any, were reported above).")


if __name__ == "__main__":
    install_requirements()
